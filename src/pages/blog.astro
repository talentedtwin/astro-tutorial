---
import Layout from "../layouts/Layout.astro";
const postLoaders = import.meta.glob("./posts/*.md");
const allPosts = await Promise.all(
  Object.entries(postLoaders).map(async ([filePath, loadPost]) => {
    const post = (await loadPost()) as any;

    return {
      // Build the route from file path: ./posts/post-1.md -> /posts/post-1/
      url: filePath.replace(".", "").replace(".md", "/"),
      title: post.frontmatter?.title ?? "Untitled post",
    };
  }),
);
const pageTitle = "My Astro Learning Blog";
---

<Layout pageTitle={pageTitle}>
  <p>This is where I will post about my journey learning Astro.</p>
  <ul>
    {
      allPosts.map((post: any) => (
        <li>
          <a href={post.url}>{post.title}</a>
        </li>
      ))
    }
  </ul>
</Layout>
